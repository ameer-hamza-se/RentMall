# Local Vite proxy destination.
API_PROXY_TARGET=http://127.0.0.1:4000
# Public API origin for builds that contact a separate API host.
VITE_API_URL=
# Public configuration from the Firebase Web app settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
