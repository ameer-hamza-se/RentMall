{
  "name": "@rentmall/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/listings/listings-router.js && node --check src/listings/listing-model.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-firestore.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0"
  }
}
