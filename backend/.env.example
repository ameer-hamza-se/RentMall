HOST=127.0.0.1
PORT=4000
# Set a MongoDB Atlas connection string when you start working with records.
MONGODB_URI=
# Comma-separated frontend origins for direct requests from hosted browsers.
ALLOWED_ORIGINS=
# Use the same Firebase project as the frontend.
FIREBASE_PROJECT_ID=
# Absolute path to the server-only Firebase Admin credential, if using a key file.
GOOGLE_APPLICATION_CREDENTIALS=
